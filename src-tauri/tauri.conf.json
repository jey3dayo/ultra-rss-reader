{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ultra RSS Reader",
  "version": "0.53.31",
  "identifier": "com.jey3dayo.ultra-rss-reader",
  "build": {
    "beforeDevCommand": "pnpm run dev:tauri:vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm exec tsc6 && pnpm exec vite build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "",
        "width": 1400,
        "height": 900,
        "minWidth": 520,
        "minHeight": 420,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' https: http:; frame-src 'self'; connect-src ipc: http://ipc.localhost; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "macOS": {
      "infoPlist": "Info.plist"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/jey3dayo/ultra-rss-reader/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdBNkQxMTFDNkM4ODM1MwpSV1JUZzhqR0VkR21CeU5RV2p1U3lqRE4rV3dhaittVkNVT25GWTV2OXFTcWxLRVRvYjBvOVhCYgo="
    }
  }
}
