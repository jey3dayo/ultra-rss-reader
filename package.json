{
  "name": "ultra-rss-reader",
  "private": true,
  "version": "0.64.4",
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": "26.4.0",
    "pnpm": "12.8.1"
  },
  "scripts": {
    "dev": "pnpm exec vite",
    "dev:tauri:vite": "node ./scripts/tauri-dev-vite-manager.ts",
    "build": "pnpm exec tsc && pnpm exec vite build",
    "typecheck": "pnpm exec tsc --noEmit",
    "preview": "pnpm exec vite preview",
    "tauri": "pnpm exec tauri",
    "format": "pnpm exec biome format --write .",
    "format:check": "pnpm exec biome format .",
    "lint": "pnpm exec biome lint .",
    "lint:fix": "pnpm exec biome lint --write .",
    "quality:react-doctor:diff": "node ./scripts/quality-baseline.ts react-doctor:diff",
    "quality:react-doctor:full": "node ./scripts/quality-baseline.ts react-doctor:full",
    "report:knip": "node ./scripts/quality-baseline.ts knip",
    "quality:lockfile-duplicate-majors": "node ./scripts/quality-baseline.ts lockfile-duplicate-majors",
    "check:release-contamination": "node ./scripts/check-release-build-contamination.ts",
    "diagnose:macos-keychain-signature": "node ./scripts/release/macos-keychain-signature-diagnostics.ts",
    "hooks:install": "lefthook install",
    "report:release-debug-flags": "node ./scripts/release-debug-feature-flags-report.ts",
    "report:similarity": "node ./scripts/similarity-report.ts",
    "report:jev": "pnpm dlx jev-lint@0.7.0 review --base origin/main",
    "test": "pnpm run test:node && pnpm run test:jsdom",
    "test:node": "pnpm exec vitest run --project node",
    "test:jsdom": "pnpm exec vitest run --project jsdom",
    "test:release-repo-contract": "pnpm exec vitest run tests/release-repo-contract.node.test.ts",
    "test:storybook:e2e": "pnpm exec playwright test --config playwright.storybook.config.ts",
    "test:watch": "pnpm exec vitest",
    "dev:portless": "portless ultra-rss-reader pnpm exec vite",
    "storybook": "storybook dev -p 6006 --no-open",
    "storybook:portless": "portless storybook.ultra-rss-reader sh -c 'storybook dev -p \"$PORT\" --host \"$HOST\" --no-open'",
    "build-storybook": "storybook build"
  },
  "knip": {
    "entry": [
      "playwright.storybook.config.ts",
      "src/dev/scenarios/index.ts"
    ],
    "ignoreIssues": {
      "src/components/ui/{button,collapsible,dialog,input,scroll-area,select}.tsx": [
        "exports",
        "types"
      ]
    },
    "ignoreDependencies": [
      "wrangler"
    ],
    "ignoreBinaries": [
      "mise"
    ]
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@praha/byethrow": "^0.12.0",
    "@sentry/react": "^11.2.0",
    "@tanstack/react-query": "^5.104.0",
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^1.49.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15",
    "tw-animate-css": "^1.4.0",
    "valibot": "^1.5.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.63.0",
    "@sentry/vite-plugin": "^5.4.0",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "agentation": "^3.1.2",
    "jsdom": "^30.1.1",
    "knip": "6.39.0",
    "lefthook": "2.1.14",
    "markdownlint-cli2": "^0.23.3",
    "portless": "^0.15.6",
    "react-doctor": "0.9.14",
    "shadcn": "^4.21.1",
    "storybook": "^10.6.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "wrangler": "4.145.0"
  }
}
