{
  "name": "ultra-rss-reader",
  "private": true,
  "version": "0.53.31",
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": "26.4.0",
    "pnpm": "11.10.0"
  },
  "scripts": {
    "dev": "pnpm exec vite",
    "dev:tauri:vite": "node ./scripts/tauri-dev-vite-manager.ts",
    "build": "pnpm exec tsc6 && pnpm exec vite build",
    "typecheck": "pnpm exec tsc --noEmit",
    "preview": "pnpm exec vite preview",
    "tauri": "pnpm exec tauri",
    "format": "pnpm exec biome format --write .",
    "format:check": "pnpm exec biome format .",
    "lint": "pnpm exec biome lint .",
    "lint:fix": "pnpm exec biome lint --write .",
    "quality:react-doctor:diff": "node ./scripts/quality-baseline.ts react-doctor:diff",
    "quality:react-doctor:full": "node ./scripts/quality-baseline.ts react-doctor:full",
    "quality:knip": "node ./scripts/quality-baseline.ts knip",
    "quality:lockfile-duplicate-majors": "node ./scripts/quality-baseline.ts lockfile-duplicate-majors",
    "quality:dependency-licenses": "node ./scripts/quality-baseline.ts dependency-licenses",
    "check:release-contamination": "node ./scripts/check-release-build-contamination.ts",
    "diagnose:macos-keychain-signature": "node ./scripts/release/macos-keychain-signature-diagnostics.ts",
    "hooks:install": "lefthook install",
    "report:release-debug-flags": "node ./scripts/release-debug-feature-flags-report.ts",
    "report:similarity": "node ./scripts/similarity-report.ts",
    "test": "pnpm run test:node && pnpm run test:jsdom",
    "test:node": "pnpm exec vitest run --project node",
    "test:jsdom": "pnpm exec vitest run --project jsdom",
    "test:release-repo-contract": "pnpm exec vitest run tests/release-repo-contract.test.ts",
    "test:storybook:e2e": "pnpm exec playwright test --config playwright.storybook.config.ts",
    "test:watch": "pnpm exec vitest",
    "dev:portless": "portless ultra-rss-reader pnpm exec vite",
    "storybook": "storybook dev -p 6006 --no-open",
    "storybook:portless": "portless storybook.ultra-rss-reader sh -c 'storybook dev -p \"$PORT\" --host \"$HOST\" --no-open'",
    "build-storybook": "storybook build"
  },
  "knip": {
    "entry": [
      "playwright.storybook.config.ts",
      "src/dev/scenarios/index.ts"
    ],
    "ignoreIssues": {
      "src/components/ui/{button,collapsible,dialog,input,scroll-area,select}.tsx": [
        "exports",
        "types"
      ]
    },
    "ignoreDependencies": [
      "markdownlint-cli2"
    ]
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@praha/byethrow": "^0.12.0",
    "@tanstack/react-query": "^5.101.2",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^1.24.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.9",
    "shadcn": "^4.13.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@playwright/test": "^1.61.1",
    "@storybook/addon-a11y": "^10.5.0",
    "@storybook/addon-docs": "^10.5.0",
    "@storybook/react-vite": "^10.5.0",
    "@tailwindcss/vite": "^4.3.2",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "agentation": "^3.0.2",
    "jsdom": "^29.1.1",
    "knip": "6.26.0",
    "lefthook": "2.1.10",
    "markdownlint-cli2": "^0.23.0",
    "portless": "^0.15.1",
    "react-doctor": "0.7.6",
    "storybook": "^10.5.0",
    "tailwindcss": "^4.3.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-7": "npm:typescript@rc",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  }
}
