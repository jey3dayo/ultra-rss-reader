{
  "name": "ultra-rss-reader",
  "private": true,
  "version": "0.31.1",
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "dev": "pnpm exec vite",
    "dev:tauri:vite": "node ./scripts/tauri-dev-vite-manager.ts",
    "build": "pnpm exec tsc && pnpm exec vite build",
    "preview": "pnpm exec vite preview",
    "tauri": "pnpm exec tauri",
    "format": "pnpm exec biome format --write .",
    "format:check": "pnpm exec biome format .",
    "lint": "pnpm exec biome lint .",
    "lint:fix": "pnpm exec biome lint --write .",
    "test": "pnpm exec vitest run",
    "test:storybook:e2e": "pnpm exec playwright test --config playwright.storybook.config.ts",
    "test:watch": "pnpm exec vitest",
    "dev:portless": "portless ultra-rss-reader pnpm exec vite",
    "storybook": "storybook dev -p 6006 --no-open",
    "storybook:portless": "portless storybook.ultra-rss-reader sh -c 'storybook dev -p \"$PORT\" --host \"$HOST\" --no-open'",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@praha/byethrow": "^0.11.1",
    "@tanstack/react-query": "^5.100.9",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "i18next": "^26.0.9",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^1.14.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-i18next": "^17.0.6",
    "shadcn": "^4.7.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@playwright/test": "^1.59.1",
    "@storybook/addon-a11y": "^10.3.6",
    "@storybook/addon-docs": "^10.3.6",
    "@storybook/react-vite": "^10.3.6",
    "@tailwindcss/vite": "^4.2.4",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "jsdom": "^29.1.1",
    "markdownlint-cli2": "^0.22.1",
    "portless": "^0.12.0",
    "storybook": "^10.3.6",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  }
}
