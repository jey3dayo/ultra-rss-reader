      <outline type="rss" text="Web Platform" title="Web Platform" xmlUrl="https://web.dev/feed.xml"/>
    </outline>
    <outline type="rss" text="Top Level" title="Top Level" xmlUrl="https://example.com/top.xml" htmlUrl="https://example.com/"/>
  </body>
</opml>
