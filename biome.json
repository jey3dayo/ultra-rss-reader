{
  "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        "noLabelWithoutControl": {
          "level": "error",
          "options": {
            "inputComponents": ["Input"]
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.test.ts", "**/*.test.tsx", "tests/**"],
      "linter": {
        "rules": {
          "correctness": {
            "noComponentHookFactories": "off",
            "noPlaywrightMissingAwait": "off",
            "usePlaywrightValidDescribeCallback": "off"
          }
        }
      }
    },
    {
      "includes": [
        "src/components/reader/hooks/use-ui-store-slice.ts",
        "src/hooks/create-mutation.ts",
        "src/hooks/create-query.ts"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noComponentHookFactories": "off"
          }
        }
      }
    }
  ],
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  },
  "css": {
    "parser": {
      "cssModules": false,
      "tailwindDirectives": true
    }
  },
  "files": {
    "includes": [
      "src/**",
      "tests/**",
      "e2e/**",
      ".storybook/**",
      "scripts/**",
      "*.ts",
      "*.tsx",
      "*.js",
      "*.json",
      "!!tests/fixtures/sanitizer",
      "!!node_modules",
      "!!.pnpm-store",
      "!!dist",
      "!!src-tauri/target",
      "!!.worktrees",
      "!!.claude/worktrees"
    ]
  }
}
