{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        "noLabelWithoutControl": {
          "level": "error",
          "options": {
            "inputComponents": ["Input"]
          }
        }
      }
    }
  },
  "overrides": [
    {
      // Playwright rules misfire on Vitest / Testing Library files; only e2e/** runs Playwright.
      "includes": ["src/**", "tests/**", ".storybook/**", "scripts/**"],
      "linter": {
        "rules": {
          "correctness": {
            "noPlaywrightMissingAwait": "off",
            "usePlaywrightValidDescribeCallback": "off"
          }
        }
      }
    },
    {
      // Module-scope hook factories (createQuery, createMutation) and test-local components that close over mocks.
      "includes": [
        "src/__tests__/**",
        "tests/**",
        "src/hooks/create-mutation.ts",
        "src/hooks/create-query.ts",
        "src/components/reader/hooks/use-ui-store-slice.ts"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noComponentHookFactories": "off"
          }
        }
      }
    }
  ],
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  },
  "css": {
    "parser": {
      "cssModules": false,
      "tailwindDirectives": true
    }
  },
  "files": {
    "includes": [
      "src/**",
      "tests/**",
      "e2e/**",
      ".storybook/**",
      "scripts/**",
      "*.ts",
      "*.tsx",
      "*.js",
      "*.json",
      "!!tests/fixtures/sanitizer",
      "!!tests/fixtures/quality-baseline",
      "!!node_modules",
      "!!.pnpm-store",
      "!!dist",
      "!!src-tauri/target",
      "!!.worktrees",
      "!!.claude/worktrees"
    ]
  }
}
